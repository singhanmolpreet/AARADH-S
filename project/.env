# Used by docker-compose.yml to configure the timescaledb container AND to
# build the backend's POSTGRES_DSN -- change these here, not in two places.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=anmolpreet
POSTGRES_DB=engines

MQTT_BROKER_PORT=1883

# Optional, defaults shown
FAKE_HEALTH_ENGINE_IDS=ENG01
FAKE_HEALTH_INTERVAL_SECONDS=10

# --- canbus/ scripts (run manually on a Linux/WSL2 host, not via compose --
# see backend/canbus/README notes on why) ---
CAN_INTERFACE=vcan0
CAN_ENGINE_ID=ENG01
FAKE_CAN_INTERVAL_SECONDS=2
